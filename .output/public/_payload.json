[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"nter":3},{"id":4,"uid":5,"url":5,"type":6,"href":7,"tags":8,"first_publication_date":9,"last_publication_date":10,"slugs":11,"linked_documents":12,"lang":13,"alternate_languages":14,"data":15},"aWe3nBIAACMAkV7a",null,"nter","https:\u002F\u002Fvibelab.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=arv6gxIAACoA5qf8&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aWe3nBIAACMAkV7a%22%29+%5D%5D",[],"2026-01-14T15:35:33+0000","2026-01-15T13:52:30+0000",[6],[],"en-gb",[],{"landing":16,"summary_text":26,"summary_image":83,"introduction":90,"belonging_quote":91,"belonging_image":92,"belonging_text":93,"space_text":94,"space_image":95,"city_quote":96,"city_text":97,"city_image":98,"recommendations":99,"previews":103,"quote_image":154},{"dimensions":17,"alt":5,"copyright":5,"url":20,"id":21,"edit":22},{"width":18,"height":19},2000,1999,"https:\u002F\u002Fimages.prismic.io\u002Fvibelab\u002FaWe82wIvOtkhBgIh_key-visual.jpg?auto=format,compress","aWe82wIvOtkhBgIh",{"x":23,"y":23,"zoom":24,"background":25},0,1,"transparent",[27,42,45,48,51,53,66,68,70,72,75,77,79],{"type":28,"text":29,"spans":30,"direction":41},"paragraph","Night-time culture powers creative industries, sustains local economies, and creates spaces for connection, experimentation and belonging. Yet, it remains structurally fragile, under-researched, and often overlooked in policy and investment terms. ",[31,35,38],{"start":32,"end":33,"type":34},154,176,"strong",{"start":36,"end":37,"type":34},177,193,{"start":39,"end":40,"type":34},204,246,"ltr",{"type":28,"text":43,"spans":44,"direction":41},"\n",[],{"type":28,"text":46,"spans":47,"direction":41},"The Nighttime Foundation was created to change this. ",[],{"type":28,"text":49,"spans":50,"direction":41},"",[],{"type":28,"text":43,"spans":52,"direction":41},[],{"type":28,"text":54,"spans":55,"direction":41},"The NTEReport is the Foundational’s flagship report that brings together original research, policy analysis, investor perspectives and on-the-ground case studies from cities around the world, reflecting the maturity and diversity of the NTE field. ",[56,60,63],{"start":57,"end":58,"type":59},4,13,"em",{"start":61,"end":62,"type":34},72,130,{"start":64,"end":65,"type":34},149,161,{"type":28,"text":49,"spans":67,"direction":41},[],{"type":28,"text":49,"spans":69,"direction":41},[],{"type":28,"text":43,"spans":71,"direction":41},[],{"type":28,"text":73,"spans":74,"direction":41},"The night is a system — shaped by governance, technology, culture, economics and place. Nightlife is a cultural asset as well as an economic frontier, with growing opportunities across real estate, hospitality, creative enterprise, safety innovation, and community-led development.",[],{"type":28,"text":49,"spans":76,"direction":41},[],{"type":28,"text":43,"spans":78,"direction":41},[],{"type":28,"text":80,"spans":81,"direction":41},"The NTEReport opens pathways for strategic investment, scalable models and long-term partnerships that can strengthen both cultural life and economic outcomes.",[82],{"start":57,"end":58,"type":59},{"dimensions":84,"alt":5,"copyright":5,"url":87,"id":88,"edit":89},{"width":85,"height":86},8000,5760,"https:\u002F\u002Fimages.prismic.io\u002Fvibelab\u002FaWjr0QIvOtkhBnBU_pexels-kelly-12530472.jpg?auto=format,compress","aWjr0QIvOtkhBnBU",{"x":23,"y":23,"zoom":24,"background":25},[],[],{},[],[],{},[],[],{},[100],{"title":101,"text":102},[],[],[104,112,118,124,130,136,142,148],{"cover":105},{"dimensions":106,"alt":5,"copyright":5,"url":109,"id":110,"edit":111},{"width":107,"height":108},1191,1684,"https:\u002F\u002Fimages.prismic.io\u002Fvibelab\u002FaWjwSQIvOtkhBnEE_NTE1.png?auto=format,compress","aWjwSQIvOtkhBnEE",{"x":23,"y":23,"zoom":24,"background":25},{"cover":113},{"dimensions":114,"alt":5,"copyright":5,"url":115,"id":116,"edit":117},{"width":107,"height":108},"https:\u002F\u002Fimages.prismic.io\u002Fvibelab\u002FaWjwTwIvOtkhBnEH_NTE2.png?auto=format,compr